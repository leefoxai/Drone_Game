{
  "name": "drone-game",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {"node": ">=22.12.0"},
  "scripts": {
    "dev": "npm run dev --workspace @drone/client --",
    "build": "npm run typecheck && npm run build --workspace @drone/client",
    "preview": "npm run preview --workspace @drone/client --",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
