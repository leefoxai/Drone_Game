{
  "name": "drone-game",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @drone/client --",
    "build": "npm run typecheck && npm run build --workspace @drone/client",
    "preview": "npm run preview --workspace @drone/client --",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && playwright test --workers=1",
    "test:ui": "playwright test --ui",
    "check": "npm test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
